{
  "name": "correspondentia-theatri",
  "version": "0.1.0",
  "description": "Correspondentia Theatri — atlante ipermediale dell'esoterismo occidentale",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "tsx scripts/genera-costanti.ts && tsx scripts/build-data.ts && tsx scripts/build-capitoli.ts",
    "dev": "npm run data && astro dev",
    "build": "npm run data && astro build",
    "preview": "astro preview",
    "test": "npm run data && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "astro check",
    "seme:estrai": "tsx kit/estrai-seme.ts",
    "seme:valida": "tsx kit/valida-seme.ts kit/esempio/seme-esoterismo.json",
    "seme:controlla": "tsx kit/estrai-seme.ts --verifica && tsx kit/valida-seme.ts kit/esempio/seme-esoterismo.json"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@fontsource-variable/eb-garamond": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sigma/node-image": "^3.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.16.0",
    "d3": "^7.9.0",
    "flexsearch": "^0.8.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "gray-matter": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.2",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "graphology-types": "^0.24.8",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
