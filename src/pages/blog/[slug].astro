---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/percorsi-url';

export async function getStaticPaths() {
  const articoli = await getCollection('blog');
  return articoli.map((articolo) => ({ params: { slug: articolo.id }, props: { articolo } }));
}

const { articolo } = Astro.props;
const { Content } = await render(articolo);

const tutti = (await getCollection('blog')).sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
const correlati = tutti.filter((a) => a.id !== articolo.id).slice(0, 2);

const dataIt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const minuti = Math.max(1, Math.round((articolo.body ?? '').split(/\s+/).length / 220));

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: articolo.data.titolo,
  description: articolo.data.sommario,
  datePublished: articolo.data.data.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: articolo.data.autore },
  isPartOf: {
    '@type': 'Blog',
    name: 'Correspondentia Theatri — Blog',
  },
});
---

<Base titolo={articolo.data.titolo} descrizione={articolo.data.sommario} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16">
    <nav aria-label="Torna al blog" class="text-sm">
      <a class="text-tenue transition-colors duration-150 hover:text-accento" href={withBase('/blog')}>
        ← Blog
      </a>
    </nav>

    <header class="mt-6 pb-8 border-b border-bordo">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 etichetta text-tenue">
        <time datetime={articolo.data.data.toISOString().slice(0, 10)}>
          {dataIt.format(articolo.data.data)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minuti} min di lettura</span>
        <span aria-hidden="true">·</span>
        <span>{articolo.data.autore}</span>
        {articolo.data.tag.map((t) => <span class="border border-bordo bg-incassato px-1.5 py-0.5">{t}</span>)}
      </p>
      <h1 class="mt-4 font-serif text-4xl sm:text-5xl leading-tight tracking-tight text-testo text-balance">
        {articolo.data.titolo}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-tenue">{articolo.data.sommario}</p>
    </header>

    <div class="prosa mt-8">
      <Content />
    </div>

    {
      correlati.length > 0 && (
        <aside aria-label="Altri articoli" class="mt-14 pt-8 border-t border-bordo">
          <h2 class="etichetta text-tenue">Continua a leggere</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {correlati.map((a) => (
              <a href={withBase(`/blog/${a.id}`)} class="carta group p-4">
                <p class="etichetta text-tenue/80">
                  <time datetime={a.data.data.toISOString().slice(0, 10)}>{dataIt.format(a.data.data)}</time>
                </p>
                <h3 class="mt-1.5 font-serif text-lg leading-snug text-testo group-hover:text-accento transition-colors duration-150">
                  {a.data.titolo}
                </h3>
              </a>
            ))}
          </div>
        </aside>
      )
    }
  </article>
</Base>
