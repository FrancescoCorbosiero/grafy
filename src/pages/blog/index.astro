---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/percorsi-url';

const articoli = (await getCollection('blog')).sort(
  (a, b) => b.data.data.getTime() - a.data.data.getTime()
);
const [evidenza, ...altri] = articoli;

const dataIt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const minutiLettura = (corpo: string | undefined) =>
  Math.max(1, Math.round((corpo ?? '').split(/\s+/).length / 220));
---

<Base
  titolo="Blog"
  descrizione="Il diario di redazione di Correspondentia Theatri: metodo, scelte editoriali e modi d'uso dell'atlante."
>
  <div class="mx-auto max-w-6xl px-4">
    <section class="pt-14 pb-10">
      <h1 class="font-serif text-4xl sm:text-5xl tracking-tight text-testo">Blog</h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-tenue">
        Il diario di redazione dell’atlante: il metodo, le scelte editoriali e i modi d’uso,
        raccontati man mano che il progetto cresce.
      </p>
    </section>

    {
      evidenza && (
        <section aria-label="In evidenza" class="pb-6">
          <a href={withBase(`/blog/${evidenza.id}`)} class="carta group block p-6 sm:p-8">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 etichetta text-tenue">
              <time datetime={evidenza.data.data.toISOString().slice(0, 10)}>
                {dataIt.format(evidenza.data.data)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{minutiLettura(evidenza.body)} min di lettura</span>
              {evidenza.data.tag.map((t) => (
                <span class="border border-bordo bg-incassato px-1.5 py-0.5">{t}</span>
              ))}
            </p>
            <h2 class="mt-3 font-serif text-3xl sm:text-4xl leading-tight tracking-tight text-testo group-hover:text-accento transition-colors duration-150 text-balance">
              {evidenza.data.titolo}
            </h2>
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-tenue">{evidenza.data.sommario}</p>
            <p class="mt-4 text-sm font-medium text-accento">
              Leggi l’articolo
              <span class="inline-block transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">
                →
              </span>
            </p>
          </a>
        </section>
      )
    }

    <section aria-label="Tutti gli articoli" class="grid gap-4 sm:grid-cols-2 pb-14">
      {
        altri.map((a) => (
          <a href={withBase(`/blog/${a.id}`)} class="carta group p-5 flex flex-col">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 etichetta text-tenue">
              <time datetime={a.data.data.toISOString().slice(0, 10)}>{dataIt.format(a.data.data)}</time>
              <span aria-hidden="true">·</span>
              <span>{minutiLettura(a.body)} min di lettura</span>
            </p>
            <h2 class="mt-2 font-serif text-2xl leading-snug tracking-tight text-testo group-hover:text-accento transition-colors duration-150">
              {a.data.titolo}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-tenue">{a.data.sommario}</p>
            <p class="mt-auto pt-3 flex flex-wrap gap-1.5">
              {a.data.tag.map((t) => (
                <span class="etichetta border border-bordo bg-incassato px-1.5 py-0.5 text-tenue">{t}</span>
              ))}
            </p>
          </a>
        ))
      }
    </section>
  </div>
</Base>
