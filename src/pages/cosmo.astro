---
import Base from '../layouts/Base.astro';
import CosmoView from '../components/islands/CosmoView';
import { withBase } from '../lib/percorsi-url';
---

<Base
  titolo="Cosmo"
  descrizione="Il grafo dell'atlante in tre dimensioni: l'asse di profondità è il tempo — le voci antiche in fondo, le moderne in superficie."
  pienaAltezza
  classeMain="relative"
>
  <div class="flex items-center gap-3 border-b border-bordo bg-rialzato px-4 py-1.5 text-xs">
    <h1 class="font-medium">Il cosmo: grafo 3D</h1>
    <p style="color: var(--testo-tenue)">Z = tempo. Vista impegnativa su dispositivi mobili.</p>
    <a class="underline text-accento ms-auto" href={withBase('/grafo')}>Vista 2D →</a>
  </div>
  <div class="h-[calc(100%-2rem)]">
    <CosmoView client:only="react" />
  </div>
</Base>
